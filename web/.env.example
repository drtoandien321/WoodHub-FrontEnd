# ===== Cấu hình kết nối Backend =====
# VITE_USE_MOCK=true  → toàn bộ dùng mock (FE chạy độc lập, không cần BE).
# VITE_USE_MOCK=false → các endpoint ĐÃ có BE (login/register) gọi BE thật;
#                       phần còn lại (products/orders/custom/supplier...) vẫn tự động dùng mock
#                       vì BE chưa làm (xem REAL_ENDPOINTS trong src/api/client.js).
VITE_USE_MOCK=false
VITE_API_URL=https://woodhub-be.onrender.com/api
# Google OAuth client ID (trùng app.google.client-id của BE). Cần khai báo http://localhost:5173
# ở "Authorized JavaScript origins" trong Google Cloud Console thì nút Google thật mới chạy.
VITE_GOOGLE_CLIENT_ID=124999965588-8d179djm0oh4go4iv51156ikhqg40jqm.apps.googleusercontent.com

# Goong Maps (bản đồ Việt Nam) — 2 key khác nhau, lấy ở https://account.goong.io
# Maps Key: cho hiển thị bản đồ (goong-js tile rendering). API Key: cho Geocoding/Reverse geocoding (REST).
VITE_GOONG_MAPTILES_KEY=
VITE_GOONG_API_KEY=