{
  "expo": {
    "name": "WoodHub",
    "slug": "woodhub-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#5B4232"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "vn.woodhub.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "intentFilters": []
    },
    "extra": {
      "apiUrl": "https://woodhub-be.onrender.com/api",
      "eas": {
        "projectId": "3831a263-a50a-4a46-846f-8e3d6928e5bc"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "WoodHub cần truy cập ảnh để dựng mô hình 3D từ ảnh của bạn.",
          "cameraPermission": "WoodHub cần camera để chụp ảnh món đồ cần dựng 3D."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WoodHub dùng vị trí để tìm xưởng mộc gần bạn."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "WoodHub cần quyền để lưu mã QR thanh toán vào thư viện ảnh.",
          "savePhotosPermission": "WoodHub lưu mã QR thanh toán vào thư viện ảnh."
        }
      ]
    ]
  }
}
